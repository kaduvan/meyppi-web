---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';

const steps = [
  {
    n: '01',
    title: 'Expected delivery',
    body: 'You give us the contract side: every creative version, the publishers, the episodes, the flight dates.',
  },
  {
    n: '02',
    title: 'Independently observed',
    body: 'We pull the published media from RSS feeds and other permitted sources, then fingerprint each episode end to end.',
  },
  {
    n: '03',
    title: 'Discrepancy detected',
    body: 'A 24-second cut where 30 seconds were bought. Version 2 where version 1 was contracted. Nothing aired at all.',
  },
  {
    n: '04',
    title: 'Evidence produced',
    body: 'Each finding ships with its evidence: hashes, offsets, match counts, timestamps. You can re-check any of it.',
  },
];

const deliverables = [
  {
    title: 'Verification report',
    body: 'Placement-by-placement status for the whole campaign, delivered as a PDF plus CSV and JSON exports.',
    icon: 'report',
  },
  {
    title: 'Evidence chain',
    body: 'Creative ID, version, file hash, match offset, covered duration, confidence. Retained for every single result.',
    icon: 'chain',
  },
  {
    title: 'Exception review',
    body: 'Where the evidence is ambiguous, a person looks at it and says so in the report. Ambiguity is reported, not smoothed over.',
    icon: 'flag',
  },
];

const icons: Record<string, string> = {
  report:
    '<path d="M7 3h7l5 5v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M14 3v5h5M9.5 13h6M9.5 16.5h6M9.5 9.5h2.5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/>',
  chain:
    '<path d="M10.5 13.5a3 3 0 0 0 4.24 0l3-3a3 3 0 0 0-4.24-4.24l-1.5 1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M13.5 10.5a3 3 0 0 0-4.24 0l-3 3a3 3 0 0 0 4.24 4.24l1.5-1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  flag:
    '<path d="M6 21V4m0 0h11l-2.5 3.5L17 11H6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
};
---

<Base
  title="Did your podcast ad actually run as contracted?"
  description="Meyppi independently verifies whether contracted audio creatives appeared in published media: when they ran, which version, and whether delivery was complete."
>
  <!-- ============ Hero ============ -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="hero__eyebrow">Independent media delivery verification</span>
        <h1>
          Did your podcast ad actually run <span class="hero__em">as contracted?</span>
        </h1>
        <p class="hero__sub">
          Meyppi checks published media itself: whether your creative
          appeared, in which version, at what timestamp, and for how long.
          Not what the publisher reports. What actually aired.
        </p>
        <div class="hero__ctas">
          <Button variant="primary" href="/contact">
            Request a Campaign Audit
          </Button>
          <Button variant="ghost" href="/sample-report">
            See a Sample Report
          </Button>
        </div>
      </div>

      <!-- Fingerprint match visual: reference creative (teal) aligned
           inside a published episode (white), constellation pairs linked -->
      <div class="hero__viz" aria-hidden="true">
        <svg viewBox="0 0 560 400" class="fp" role="img">
          <!-- panel frame -->
          <rect x="1" y="1" width="558" height="398" rx="6"
                fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.14)"/>

          <!-- reference creative track -->
          <text x="24" y="52" class="fp__label">REFERENCE · CR-A v1 · 30s</text>
          <g class="fp__ref">
            <path d="M24 84 L44 60 L64 96 L84 52 L104 92 L124 64 L144 88 L164 56 L184 94 L204 62 L224 90 L244 58 L264 92 L284 66 L304 86 L324 54 L344 94 L364 60 L384 90 L404 64 L424 88 L444 58 L464 92 L484 68 L504 86 L524 62"
                  class="fp__wave fp__wave--teal"/>
          </g>
          <g class="fp__dots fp__dots--ref">
            {[44, 84, 124, 164, 204, 244, 284, 324, 364, 404, 444, 484].map((x, i) => (
              <circle cx={x} cy={[60, 52, 64, 56, 62, 58, 66, 54, 60, 64, 58, 68][i]} r="3"
                      class="fp__dot fp__dot--teal" style={`animation-delay:${i * 0.18}s`}/>
            ))}
          </g>

          <!-- published episode track -->
          <text x="24" y="236" class="fp__label">PUBLISHED EPISODE · EP-1041 · 42:10</text>
          <g class="fp__ep">
            <path d="M24 268 L54 250 L84 282 L114 246 L144 278 L174 254 L204 280 L234 252 L264 276 L294 250 L324 278 L354 252 L384 276 L414 250 L444 280 L474 254 L504 278 L524 262"
                  class="fp__wave fp__wave--dim"/>
            <!-- matched region inside the episode -->
            <rect x="184" y="242" width="160" height="46" rx="3" class="fp__hitbox"/>
            <path d="M184 268 L204 280 L224 254 L244 276 L264 258 L284 272 L304 256 L324 278 L344 260"
                  class="fp__wave fp__wave--teal fp__wave--matched"/>
          </g>
          <g class="fp__dots fp__dots--ep">
            {[204, 244, 284, 324].map((x, i) => (
              <circle cx={x} cy={[280, 276, 272, 278][i]} r="3"
                      class="fp__dot fp__dot--teal" style={`animation-delay:${0.7 + i * 0.22}s`}/>
            ))}
          </g>

          <!-- constellation links between matched pairs -->
          <g class="fp__links">
            <line x1="164" y1="56" x2="204" y2="280" class="fp__link"/>
            <line x1="244" y1="58" x2="284" y2="272" class="fp__link"/>
            <line x1="324" y1="54" x2="364" y2="260" class="fp__link"/>
            <line x1="404" y1="64" x2="444" y2="280" class="fp__link"/>
          </g>

          <!-- match badge -->
          <g class="fp__badge">
            <rect x="308" y="330" width="228" height="40" rx="4" class="fp__badge-box"/>
            <circle cx="330" cy="350" r="4" class="fp__badge-led"/>
            <text x="346" y="355" class="fp__badge-text">MATCH @ 00:01:30 · 3350 HASHES</text>
          </g>

          <!-- coverage bar -->
          <g class="fp__cov">
            <text x="24" y="345" class="fp__label">COVERAGE</text>
            <rect x="24" y="354" width="240" height="8" rx="4" fill="rgba(255,255,255,0.12)"/>
            <rect x="24" y="354" width="240" height="8" rx="4" class="fp__cov-fill"/>
          </g>
        </svg>
      </div>
    </div>

    <!-- trust strip -->
    <div class="hero__strip">
      <div class="container hero__strip-inner">
        <span>We are not your agency and not your publisher</span>
        <span class="hero__strip-div" aria-hidden="true"></span>
        <span>Four possible verdicts per placement, never a vague "verified"</span>
        <span class="hero__strip-div" aria-hidden="true"></span>
        <span>Evidence, on record. Not legal proof, and we say so</span>
      </div>
    </div>
  </section>

  <!-- ============ Problem ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">The problem</span>
        <h2>Nobody independently confirms delivery.</h2>
      </div>
      <div class="rule-cols reveal">
        <div>
          <h3>You paid for 240 placements.</h3>
          <p>
            The publisher reports 240. Your spreadsheet says 240. The
            invoice is for 240. And not one of those numbers came from
            anyone whose job was to check.
          </p>
        </div>
        <div>
          <h3>You don't know what actually aired.</h3>
          <p>
            A 24-second cut instead of 30. Version 2 instead of version 1.
            An episode that quietly dropped out of the feed. Self-reported
            data cannot see any of this, because it is the thing being
            reported on.
          </p>
        </div>
        <div>
          <h3>You can't prove it either way.</h3>
          <p>
            When something feels wrong, the conversation stalls at "our
            report says it ran." Without independent evidence there is no
            reconciliation, no makegood, and nothing to show your client.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ What Meyppi does ============ -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">What Meyppi does</span>
        <h2>From expected delivery to defensible evidence.</h2>
      </div>
      <ol class="timeline reveal">
        {steps.map((s) => (
          <li>
            <span class="timeline__num">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ Product preview ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">The deliverable</span>
        <h2>A discrepancy report you can put in front of a client.</h2>
        <p class="section__lede">
          Not a dashboard login, not a slide deck. A report: every placement
          classified, every classification backed by evidence you can open
          and inspect.
        </p>
      </div>

      <div class="preview reveal">
        <div class="preview__chrome" aria-hidden="true">
          <span></span><span></span><span></span>
          <em>meyppi · campaign CMP-XXXXX</em>
        </div>
        <div class="preview__body">
          <div class="preview__summary">
            <div class="stat"><span class="stat__num">5</span><span class="stat__label">Expected</span></div>
            <div class="stat"><span class="stat__num">2</span><span class="stat__label">Verified full</span></div>
            <div class="stat"><span class="stat__num">1</span><span class="stat__label">Partial</span></div>
            <div class="stat"><span class="stat__num">1</span><span class="stat__label">Version mismatch</span></div>
            <div class="stat"><span class="stat__num">1</span><span class="stat__label">Not detected</span></div>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th>Content</th><th>Publisher</th><th>Expected</th><th>Observed</th><th>Classification</th></tr>
              </thead>
              <tbody>
                <tr><td class="mono">EP-1041</td><td>Publisher A</td><td>CR-A v1 · 30s</td><td>v1 · 30.0s @ 00:01:30</td><td><span class="chip chip--full">Detected — Full</span></td></tr>
                <tr><td class="mono">EP-1042</td><td>Publisher A</td><td>CR-A v1 · 30s</td><td>v1 · 24.0s (tail missing)</td><td><span class="chip chip--partial">Detected — Partial</span></td></tr>
                <tr><td class="mono">EP-1043</td><td>Publisher B</td><td>CR-A v1 · 30s</td><td>v2 aired (substituted)</td><td><span class="chip chip--mismatch">Version Mismatch</span></td></tr>
                <tr><td class="mono">EP-1044</td><td>Publisher B</td><td>CR-A v1 · 30s</td><td>No occurrence found</td><td><span class="chip chip--notdetected">Not Detected</span></td></tr>
              </tbody>
            </table>
          </div>
          <div class="preview__foot">
            <a href="/sample-report">Read the full sample report</a>
            <a href="/demo">Or explore it interactively</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ What you get ============ -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">What you get</span>
        <h2>Three deliverables per audit.</h2>
      </div>
      <div class="grid grid--3">
        {deliverables.map((d) => (
          <div class="card reveal">
            <span class="card__icon" set:html={icons[d.icon]} aria-hidden="true" />
            <h3>{d.title}</h3>
            <p>{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Who it's for ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Who it's for</span>
        <h2>Built for media buyers.</h2>
      </div>
      <div class="grid grid--2">
        <div class="card card--flat reveal">
          <h3>For agencies</h3>
          <p>
            Your name is on the client report. Meyppi gives you numbers you
            did not produce yourself, which is exactly what makes them worth
            having when a placement is disputed.
          </p>
          <a href="/for-agencies">How agencies work with us</a>
        </div>
        <div class="card card--flat reveal">
          <h3>For brands</h3>
          <p>
            You approve the plan and you pay the invoice. Verification that
            starts from the published media tells you what ran, regardless
            of what anyone's report says.
          </p>
          <a href="/for-brands">How brands work with us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Trust and scope ============ -->
  <section class="section section--dark">
    <div class="container trust">
      <span class="kicker">Trust and scope</span>
      <p class="trust__text">
        Meyppi verifies pre-produced audio creatives in podcast and digital
        audio content where the published media is independently observable.
        We do not claim legal proof. Every result comes back classified as
        Detected, Not Detected, Insufficient Signal, or Manual Review
        Required. If we cannot see the media, we do not guess.
      </p>
    </div>
  </section>

  <!-- ============ Final CTA ============ -->
  <section class="cta-band">
    <div class="container">
      <h2>Give us one completed campaign.</h2>
      <p>We'll tell you exactly what ran, and back every line of it.</p>
      <Button variant="primary" href="/contact">
        Request a Campaign Audit
      </Button>
    </div>
  </section>
</Base>

<style>
  /* ---- hero ---- */
  .hero {
    background: var(--indigo-deep);
    background-image: var(--grid-dots);
    color: var(--white);
    padding: clamp(64px, 8vw, 104px) 0 0;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    padding-bottom: clamp(48px, 6vw, 72px);
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 20px;
  }
  .hero__eyebrow::before {
    content: '';
    width: 26px;
    height: 2px;
    background: var(--teal);
  }
  .hero h1 {
    color: var(--white);
    font-size: clamp(2.3rem, 4.8vw, 3.6rem);
    margin-bottom: 20px;
  }
  .hero__em {
    color: var(--teal);
  }
  .hero__sub {
    color: #c9d3e4;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    max-width: 520px;
    margin-bottom: 32px;
  }
  .hero__ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero__ctas .btn--primary {
    background: var(--teal-dark);
  }
  .hero__ctas .btn--primary:hover {
    background: var(--teal);
  }

  /* ---- fingerprint viz ---- */
  .hero__viz {
    display: flex;
    justify-content: center;
  }
  .fp {
    width: 100%;
    max-width: 560px;
    height: auto;
  }
  .fp__label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    fill: #8fa0bd;
  }
  .fp__wave {
    fill: none;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .fp__wave--teal {
    stroke: var(--teal);
  }
  .fp__wave--dim {
    stroke: rgba(255, 255, 255, 0.32);
  }
  .fp__wave--matched {
    stroke-width: 2.8;
  }
  .fp__hitbox {
    fill: rgba(15, 163, 163, 0.1);
    stroke: rgba(15, 163, 163, 0.55);
    stroke-dasharray: 5 4;
    stroke-width: 1.2;
  }
  .fp__dot {
    fill: var(--teal);
    animation: fp-pulse 2.6s ease-in-out infinite;
  }
  @keyframes fp-pulse {
    0%, 100% { opacity: 0.45; }
    50% { opacity: 1; }
  }
  .fp__link {
    stroke: rgba(15, 163, 163, 0.5);
    stroke-width: 1.2;
    stroke-dasharray: 4 5;
    animation: fp-flow 3.2s linear infinite;
  }
  @keyframes fp-flow {
    to { stroke-dashoffset: -36; }
  }
  .fp__badge-box {
    fill: rgba(15, 163, 163, 0.12);
    stroke: var(--teal);
    stroke-width: 1.2;
  }
  .fp__badge-led {
    fill: var(--teal);
    animation: fp-pulse 1.6s ease-in-out infinite;
  }
  .fp__badge-text {
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 600;
    fill: var(--white);
    letter-spacing: 0.05em;
  }
  .fp__cov-fill {
    fill: var(--teal);
    transform-origin: 24px 358px;
    animation: fp-fill 4s ease-in-out infinite;
  }
  @keyframes fp-fill {
    0% { transform: scaleX(0.3); }
    55% { transform: scaleX(1); }
    100% { transform: scaleX(1); }
  }

  /* ---- trust strip ---- */
  .hero__strip {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(18, 29, 51, 0.6);
  }
  .hero__strip-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    padding-top: 16px;
    padding-bottom: 16px;
    font-size: 13.5px;
    color: #9fabc2;
    text-align: center;
  }
  .hero__strip-div {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--teal);
    flex: none;
  }

  /* ---- preview ---- */
  .preview {
    border: 1px solid var(--grey);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-3);
    overflow: hidden;
  }
  .preview__chrome {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 18px;
    background: var(--off-white);
    border-bottom: 1px solid var(--grey-soft);
  }
  .preview__chrome span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--grey);
  }
  .preview__chrome em {
    margin-left: 12px;
    font-style: normal;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  .preview__body {
    padding: 28px clamp(16px, 3vw, 32px) 24px;
  }
  .preview__summary {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--grey-soft);
  }
  .preview__summary .stat__num {
    font-size: 1.9rem;
  }
  .preview__foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 20px;
    font-size: 15px;
    font-weight: 600;
  }

  /* ---- trust ---- */
  .trust {
    max-width: 860px;
  }
  .trust__text {
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    line-height: 1.7;
    color: #c9d3e4;
    max-width: 64ch;
  }

  /* ---- CTA band ---- */
  .cta-band {
    background: var(--indigo);
    color: var(--white);
    text-align: center;
    padding: clamp(64px, 8vw, 96px) 0;
  }
  .cta-band h2 {
    color: var(--white);
    margin-bottom: 4px;
  }
  .cta-band p {
    color: #d8dde5;
    font-size: 1.15rem;
    margin-bottom: 28px;
  }
  .cta-band .btn--primary {
    background: var(--teal-dark);
  }
  .cta-band .btn--primary:hover {
    background: var(--teal);
  }

  @media (max-width: 1020px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__viz {
      order: -1;
    }
    .fp {
      max-width: 480px;
    }
  }
  @media (max-width: 720px) {
    .preview__summary {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
