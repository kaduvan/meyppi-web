---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';

// Data below is from a real Meyppi engine run (synthetic demo campaign,
// clearly labeled). Same pipeline, same report format as a paid audit.
const placements = [
  {
    content: 'EP-1041',
    publisher: 'Publisher A (redacted)',
    expected: 'CR-A v1 · 30s',
    observed: 'CR-A v1 · 30.0s @ 00:01:30',
    cls: 'full',
    clsLabel: 'Detected — Full',
    conf: '0.99',
  },
  {
    content: 'EP-1042',
    publisher: 'Publisher A (redacted)',
    expected: 'CR-A v1 · 30s',
    observed: 'CR-A v1 · 24.2s (tail missing 5.75s)',
    cls: 'partial',
    clsLabel: 'Detected — Partial',
    conf: '0.90',
  },
  {
    content: 'EP-1043',
    publisher: 'Publisher B (redacted)',
    expected: 'CR-A v1 · 30s',
    observed: 'CR-A v2 aired (version substituted)',
    cls: 'mismatch',
    clsLabel: 'Version Mismatch',
    conf: '0.90',
  },
  {
    content: 'EP-1044',
    publisher: 'Publisher B (redacted)',
    expected: 'CR-A v1 · 30s',
    observed: 'No occurrence found',
    cls: 'notdetected',
    clsLabel: 'Not Detected',
    conf: '0.95',
  },
  {
    content: 'EP-1045',
    publisher: 'Publisher C (redacted)',
    expected: 'CR-A v2 · 30s',
    observed: 'CR-A v2 · 30.0s',
    cls: 'full',
    clsLabel: 'Detected — Full',
    conf: '0.99',
  },
];

const evidenceEvent = {
  event_id: 'VE_CMP_XXXXX_CR-A_v1_EP-1041',
  campaign_id: 'CMP-XXXXX',
  creative_id: 'CR-A',
  version_tag: 'v1',
  source_id: 'SRC_POD-1',
  content_id: 'EP-1041',
  timestamp: '2026-10-07T12:00:00+00:00',
  match_type: 'full',
  duration_sec: 30.0,
  evidence_tier: 2,
  confidence: 0.99,
  processing: {
    engine: 'meyppi-fingerprint 1.0',
    attributed_version: 'v1',
    content_sha256: '9f2c…a41d (redacted)',
  },
  evidence: {
    offset_sec: 90.001,
    covered_time_sec: 30.0,
    coverage_ratio: 1.0,
    match_count: 3350,
    missing_head_sec: 0.0,
    missing_tail_sec: 0.0,
  },
};
---

<Base
  title="Sample Report"
  description="An illustrative Meyppi campaign audit report: placement-by-placement classification, evidence chain, and methodology."
>
  <section class="section">
    <div class="container">
      <div class="report-head">
        <div>
          <span class="kicker">Illustrative sample</span>
          <h1>Campaign Delivery Audit</h1>
        </div>
        <div class="report-head__meta">
          <p><strong>Campaign:</strong> CMP-XXXXX (redacted)</p>
          <p><strong>Client:</strong> [Redacted]</p>
          <p><strong>Audit period:</strong> 01–30 Sep 2026</p>
          <p><strong>Report issued:</strong> 7 Oct 2026</p>
        </div>
      </div>

      <p class="note">
        This sample was produced by the real Meyppi pipeline on an
        illustrative synthetic campaign, so every number below is a genuine
        engine output, including the partial detection and the version
        mismatch. The scenario was run with a fixed clock
        for reproducibility, which is why event timestamps are round. Client, campaign and publisher identifiers are redacted.
        A paid audit delivers this exact format with your campaign's data.
      </p>

      <!-- Summary -->
      <div class="summary-grid">
        <div class="summary-grid__item">
          <span class="summary-grid__num">5</span>
          <span class="summary-grid__label">Expected</span>
        </div>
        <div class="summary-grid__item">
          <span class="summary-grid__num">2</span>
          <span class="summary-grid__label">Detected — Full</span>
        </div>
        <div class="summary-grid__item warn">
          <span class="summary-grid__num">1</span>
          <span class="summary-grid__label">Partial</span>
        </div>
        <div class="summary-grid__item warn">
          <span class="summary-grid__num">1</span>
          <span class="summary-grid__label">Version Mismatch</span>
        </div>
        <div class="summary-grid__item warn">
          <span class="summary-grid__num">1</span>
          <span class="summary-grid__label">Not Detected</span>
        </div>
        <div class="summary-grid__item">
          <span class="summary-grid__num">0</span>
          <span class="summary-grid__label">Manual review</span>
        </div>
      </div>

      <!-- Placement table -->
      <h2 style="margin-top:48px">Placement detail</h2>
      <div class="table-wrap card mobile-cards" style="padding:0">
        <table>
          <thead>
            <tr>
              <th>Content</th>
              <th>Publisher</th>
              <th>Expected</th>
              <th>Observed</th>
              <th>Classification</th>
              <th>Confidence</th>
            </tr>
          </thead>
          <tbody>
            {placements.map((p) => (
              <tr>
                <td class="mono" data-label="Content">{p.content}</td>
                <td data-label="Publisher">{p.publisher}</td>
                <td data-label="Expected">{p.expected}</td>
                <td data-label="Observed">{p.observed}</td>
                <td data-label="Classification">
                  <span class={`chip chip--${p.cls}`}>{p.clsLabel}</span>
                </td>
                <td data-label="Confidence">{p.conf}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="demo-callout">
        <div>
          <h3>Rather poke at it yourself?</h3>
          <p>
            The interactive version of this report lets you filter by
            classification and open any placement to inspect its evidence:
            the verification event and where the ad landed in the episode.
          </p>
        </div>
        <a class="btn btn--primary" href="/demo">
          Open the interactive demo
        </a>
      </div>

      <!-- Evidence example -->
      <h2 style="margin-top:48px">Evidence: one verification event</h2>
      <p>
        This is what sits behind a single row of the table: the full
        verification event for EP-1041, as exported with the report. The
        offset, the coverage ratio, the match count, the file hash. In a
        paid audit you receive one of these for every placement, and the
        raw evidence is never discarded after classification.
      </p>
      <pre class="evidence"><code>{JSON.stringify(evidenceEvent, null, 2)}</code></pre>

      <!-- Appendix -->
      <h2 style="margin-top:48px">Methodology</h2>
      <p>
        Master creatives are fingerprinted: each is reduced to a
        constellation of spectral landmarks, robust to compression and
        background noise, and matched against the published media with
        temporal alignment. Reference coverage, continuity, gap analysis,
        and alignment consistency determine each classification. When the
        evidence does not support a call, the placement is marked
        Insufficient Signal or Manual Review Required, and the reason is
        stated in the report.
      </p>

      <h3>Classification definitions</h3>
      <ul>
        <li><strong>Detected — Full:</strong> the creative aired, complete delivery.</li>
        <li><strong>Detected — Partial:</strong> the creative aired, delivery incomplete (e.g. trimmed duration).</li>
        <li><strong>Version Mismatch:</strong> a different version of the creative aired.</li>
        <li><strong>Not Detected:</strong> no matching evidence found in the published episode.</li>
        <li><strong>Insufficient Signal:</strong> media quality too low for a defensible result.</li>
        <li><strong>Manual Review Required:</strong> evidence ambiguous; reviewed by an analyst.</li>
        <li><strong>Out of Scope:</strong> the placement's published media could not be obtained from any permitted source; a scope status, not a verdict.</li>
      </ul>

      <p class="note">
        Meyppi reports algorithmic findings from acoustic fingerprint
        evidence. Algorithmic confidence is not legal proof.
      </p>

      <div style="margin-top:40px; display:flex; gap:16px; flex-wrap:wrap">
        <Button variant="primary" href="/contact">
          Request a Campaign Audit
        </Button>
        <button class="btn btn--secondary" data-print>
          Print / Save as PDF
        </button>
      </div>
    </div>
  </section>
</Base>

<style>
  .report-head {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    align-items: flex-end;
    margin-bottom: 24px;
  }
  .report-head__meta p {
    margin: 0;
    font-size: 15px;
  }
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    margin-top: 32px;
  }
  .summary-grid__item {
    border: 1px solid var(--grey);
    border-radius: var(--radius);
    padding: 20px 16px;
    text-align: center;
    background: var(--white);
  }
  .summary-grid__item.warn {
    border-color: #d8a63a;
    background: #fbf3e2;
  }
  .summary-grid__num {
    display: block;
    font-size: 2rem;
    font-weight: 700;
    color: var(--indigo);
  }
  .summary-grid__label {
    font-size: 13px;
    color: var(--muted);
  }
  .evidence {
    background: var(--indigo-deep);
    color: #d7e2f2;
    padding: 24px;
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.5;
  }
  .demo-callout {
    margin-top: 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    padding: 26px 28px;
    border: 1px solid var(--teal);
    border-left-width: 4px;
    border-radius: var(--radius-lg);
    background: var(--teal-tint);
  }
  .demo-callout h3 {
    margin-bottom: 6px;
  }
  .demo-callout p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    max-width: 56ch;
  }
  @media (max-width: 900px) {
    .summary-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media print {
    .nav,
    .footer,
    .btn {
      display: none !important;
    }
    body {
      font-size: 13px;
    }
    .section {
      padding: 16px 0;
    }
  }
</style>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => {
    window.print();
  });
</script>
