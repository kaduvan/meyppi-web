---
/** Meyppi logo lockups, rendered from the approved brand PNGs
    (generated by scripts/make-icons.mjs from brand-assets/logo-a.png). */
interface Props {
  variant?: 'full' | 'reverse' | 'mark' | 'mark-reverse' | 'icon';
  width?: number;
  class?: string;
}
const { variant = 'full', width = 150, class: className } = Astro.props;

const SRC = {
  full: { src: '/brand/logo-full.png', ratio: 136 / 480 },
  reverse: { src: '/brand/logo-full-reverse.png', ratio: 136 / 480 },
  mark: { src: '/brand/logo-mark.png', ratio: 170 / 960 },
  'mark-reverse': { src: '/brand/logo-mark-reverse.png', ratio: 170 / 960 },
} as const;
---

{
  variant === 'icon' ? (
    <img src="/favicon.svg" alt="Meyppi" width={width} height={width} class={className} />
  ) : (
    <img
      src={SRC[variant].src}
      alt="Meyppi"
      width={width}
      height={Math.round(width * SRC[variant].ratio)}
      class={className}
    />
  )
}
