---
/** Footer per brief §4: dark indigo, 4 columns, மெய் watermark. */
import Logo from './Logo.astro';
import { SITE } from '../lib/site';

const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Company',
    links: [
      { href: '/about', label: 'About' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    heading: 'Product',
    links: [
      { href: '/how-it-works', label: 'How It Works' },
      { href: '/pricing', label: 'Pricing' },
      { href: '/sample-report', label: 'Sample Report' },
      { href: '/free-check', label: 'Free Check' },
      { href: '/demo', label: 'Interactive Demo' },
    ],
  },
  {
    heading: 'Use Cases',
    links: [
      { href: '/for-agencies', label: 'For Agencies' },
      { href: '/for-brands', label: 'For Brands' },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { href: '/methodology', label: 'Methodology' },
      { href: '/security', label: 'Security & Data' },
      { href: '/privacy', label: 'Privacy' },
      { href: '/terms', label: 'Website Terms' },
      { href: '/service-terms', label: 'Service Terms' },
    ],
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer__brand">
      <Logo variant="reverse" width={150} />
      <p class="footer__tag">
        Independent media delivery verification. From Tamil
        <em>mei</em> (மெய்), truth.
      </p>
    </div>
    <div class="footer__grid">
      {columns.map((col) => (
        <div>
          <h3>{col.heading}</h3>
          <ul>
            {col.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <!-- FOUNDER TODO: add legal entity name, registration number,
         GSTIN and registered address here once confirmed for publication. -->
    <div class="footer__bottom">
      <span>© {year} Meyppi · Independent media delivery verification</span>
      <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--indigo-deep);
    color: var(--white);
    position: relative;
    overflow: hidden;
    padding: 64px 0 28px;
  }
  .footer__brand {
    margin-bottom: 44px;
    max-width: 360px;
    position: relative;
  }
  .footer__tag {
    margin: 14px 0 0;
    font-size: 14px;
    color: #9fabc2;
  }
  .footer__tag em {
    font-style: normal;
    color: var(--teal);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    position: relative;
  }
  .footer h3 {
    color: var(--white);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    margin-bottom: 14px;
  }
  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer li {
    margin-bottom: 10px;
  }
  .footer a {
    color: #d8dde5;
    text-decoration: none;
    font-size: 15px;
  }
  .footer a:hover {
    color: var(--teal);
  }
  .footer__bottom {
    border-top: 1px solid rgba(216, 221, 229, 0.25);
    margin-top: 40px;
    padding-top: 20px;
    font-size: 13px;
    color: #d8dde5;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
